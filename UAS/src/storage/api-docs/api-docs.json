    "components": {
        "schemas": {
            "Laporan": {
                "title": "Laporan",
                "required": [
                    "id",
                    "judul",
                    "description",
                    "kategori",
                    "lokasi",
                    "status"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "judul": {
                        "type": "string",
                        "example": "Jalan Berlubang di Perempatan"
                    },
                    "description": {
                        "type": "string",
                        "example": "Terdapat lubang cukup dalam yang membahayakan pengendara motor."
                    },
                    "kategori": {
                        "type": "string",
                        "enum": [
                            "berlubang",
                            "rusak",
                            "ambles"
                        ],
                        "example": "berlubang"
                    },
                    "lokasi": {
                        "type": "string",
                        "example": "Jl. Sudirman No. 10, Tangerang"
                    },
                    "foto": {
                        "type": "string",
                        "example": "01K0PRVTWVH53C88GP9DZP9R0R.jpg",
                        "nullable": true
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "parah",
                            "biasa"
                        ],
                        "example": "parah"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-07-21T10:00:00Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-07-21T10:00:00Z"
                    }
                },
                "type": "object"
            }
        },
